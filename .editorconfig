root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.toml]
indent_size = 2

[*.kt]
indent_size = 4

[*.kts]
indent_size = 4

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
